# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- Application ---
ENVIRONMENT=development

# --- MongoDB ---
# Local MongoDB:      mongodb://localhost:27017
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017 
MONGODB_DB_NAME=edupath

# --- JWT ---
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS / cookies ---
# Comma-separated list of frontend origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:5173
# Set COOKIE_SECURE=true whenever the site is served over HTTPS (required in production).
COOKIE_SECURE=false
# lax | strict | none   ("none" requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# Leave empty for host-only cookies.
COOKIE_DOMAIN=
